# Copy to .env, fill the key locally, then chmod 600 .env. Do not commit .env.
SAYDO_LLM_RESPONSES_URL="https://trendengine.site/v1/responses"
SAYDO_LLM_API_KEY=""
SAYDO_LLM_MODEL="gpt-5.6-terra"
# Empty disables automatic model fallback.
SAYDO_LLM_FALLBACK_MODEL=""
SAYDO_LLM_REASONING_EFFORT="medium"
# Optional explicit HTTP proxy for the model provider only; robot requests stay direct.
SAYDO_LLM_PROXY=""
SAYDO_ROBOT_URL="http://127.0.0.1:8089"
SAYDO_ROBOT_TOKEN_FILE="~/.local/share/saydo-mcp/robot-backend-token"
# read_only / preview / execute. Only execute exposes physical action tools.
SAYDO_RUNNER_MODE="preview"
